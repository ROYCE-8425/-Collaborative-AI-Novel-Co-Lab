# ==============================================================================
# Mono-repo Environment Configuration (Template)
# Copy this file to .env at root or specify inside individual workspaces
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (NestJS App)
# ------------------------------------------------------------------------------
PORT=3001
MONGODB_URI=mongodb://localhost:27017/collaborative-novel
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js App)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# AI Provider Configurations
# ------------------------------------------------------------------------------
# AI_MODE: Set to "mock" for local simulations or "production" to call real APIs
AI_MODE=mock

# Providers: mock | gemini | xai | openrouter | ollama
AI_LORE_PROVIDER=gemini
AI_LORE_MODEL=gemini-2.5-flash-lite

AI_WRITER_PROVIDER=xai
AI_WRITER_MODEL=grok-beta

AI_STRUCTURE_PROVIDER=gemini
AI_STRUCTURE_MODEL=gemini-2.5-flash-lite

# API Keys and endpoints
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434

# Safety Configurations
AI_REQUEST_TIMEOUT_MS=30000
AI_FALLBACK_TO_MOCK=true

